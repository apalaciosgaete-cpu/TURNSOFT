# TURNSOFT - Backend variables de entorno
# Copiar este archivo a .env y ajustar los valores

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
# En producción usar la cadena de conexión de Supabase (incluye TLS).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=turnsoft_db

# JWT (OBLIGATORIO en producción: mínimo 32 caracteres, aleatorio)
# Genera uno con: openssl rand -hex 48
# Con NODE_ENV distinto de development/test, el servidor no arranca sin él.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Configuración inicial (crear el supervisor maestro)
# Código que debe ingresarse en la pantalla de setup. Sin SETUP_TOKEN, el setup
# queda deshabilitado en producción. Una vez creado el supervisor puede quitarse.
SETUP_TOKEN=

# CORS
CORS_ORIGIN=http://localhost:5173

# Puerto del frontend
FRONTEND_URL=http://localhost:5173