# TURNSOFT - Backend variables de entorno
# Copiar este archivo a .env y ajustar los valores

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
# En producción usar la cadena de conexión de Supabase (incluye TLS).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=turnsoft_db

# JWT
JWT_SECRET=cambiar_por_un_secreto_seguro_en_produccion
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Puerto del frontend
FRONTEND_URL=http://localhost:5173